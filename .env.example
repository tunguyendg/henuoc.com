# App
NEXT_PUBLIC_SITE_URL=https://henuoc.com
# true = cho Google index (chỉ bật ngày launch). Bỏ trống = noindex toàn site.
NEXT_PUBLIC_ALLOW_INDEXING=
NEXT_PUBLIC_MEDIA_URL=https://media.henuoc.com
# Key Google Maps Embed — PUBLIC (nằm trong JS trình duyệt). Lấy: Google Cloud → bật "Maps Embed API"
# → tạo API key → Application restriction = HTTP referrers (https://henuoc.com/*, http://localhost:3000/*)
# + API restriction = chỉ Maps Embed API. Bỏ trống → thiệp chỉ hiện nút Chỉ đường.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Database (Supabase, ap-southeast-1 — ADR-004). Data API tắt, chỉ truy cập qua Prisma trên server.
# App: pooler cổng 6543 (transaction mode)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Migrate (Prisma CLI): cổng 5432. Host direct db.<ref>.supabase.co chỉ có IPv6 → máy không có IPv6 dùng session pooler như dưới
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Auth (Better Auth, T-032)
# Khoá ký phiên, ≥ 32 ký tự. Tự sinh: openssl rand -base64 32. Mỗi môi trường một khoá riêng.
BETTER_AUTH_SECRET=
# URL gốc của app: local http://localhost:3000, production https://henuoc.com
BETTER_AUTH_URL=https://henuoc.com
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Crypto
TOKEN_ENC_KEY=             # openssl rand -base64 32 (32 bytes)

# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=henuoc-media

# Email (gửi mã OTP đăng nhập). resend.com → API Keys → Create (quyền Sending access). Bắt đầu bằng re_
RESEND_API_KEY=
EMAIL_FROM="Hẹn Ước <xinchao@henuoc.com>"

# ACCESSTRADE
ACCESSTRADE_TOKEN=
ACCESSTRADE_SHOPEE_CAMPAIGN_ID=

# Cron
CRON_SECRET=               # openssl rand -hex 24
