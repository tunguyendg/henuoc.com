{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NODE_TLS_REJECT_UNAUTHORIZED": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint -- *)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(ls *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx prisma migrate *)",
      "Bash(codex *)",
      "Edit(./.github/**)",
      "Edit(./prisma/migrations/**)",
      "Edit(./.claude/settings.json)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/*.pem)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(printenv *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(npx prisma migrate reset *)",
      "Edit(./public/images/**)",
      "Write(./public/images/**)"
    ]
  }
}
